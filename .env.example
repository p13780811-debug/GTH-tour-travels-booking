# GTH PRO environment template
# Copy to .env.local for local development.
# Never commit real secret values.

# =========================
# PUBLIC / CLIENT-SAFE
# =========================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =========================
# SERVER-ONLY / REQUIRED BY FEATURES
# =========================
OPENAI_API_KEY=
GEMINI_API_KEY=
TRAVELPAYOUTS_TOKEN=
# Existing deployment alias; either name is supported.
TRAVELPAYOUTS_API_TOKEN=
AVIASALES_API_TOKEN=
PEXELS_API_KEY=

# Shared request protection. Keep URL/token server-only.
# No in-memory fallback: protected calls return 503 until configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GTH_RATE_LIMIT_NAMESPACE=gth-pro

# =========================
# SERVER-ONLY / OFFLINE INGESTION
# =========================
# Keep disabled in web deployments. Enable only for an intentional admin/import run.
GTH_INGESTION_ENABLED=false
SUPABASE_INGESTION_KEY=

# Reserved for future internal authenticated services.
GTH_INTERNAL_KEY=

# =========================
# PUBLIC SEARCH LAUNCH (SERVER-ONLY CONFIG)
# =========================
# Set true ONLY for the Vercel production environment when the custom domain
# and SEO metadata are ready. Preview builds remain noindex.
GTH_PUBLIC_LAUNCH_ENABLED=false

# =========================
# OPTIONAL GOOGLE MAPS PLACE PHOTOS (SERVER-ONLY, BILLABLE)
# =========================
# OFF by default. Never bulk-import Google Maps/Places content into Supabase.
# Requires Google Cloud Places API (New), a restricted server-only key, billing,
# a Google Maps Platform-compliant privacy policy, and a Google Cloud API quota.
# The hotel visitor explicitly clicks to fetch one live photo, credited to Google Maps.
GOOGLE_PLACES_API_KEY=
GTH_GOOGLE_PLACES_ON_DEMAND_ENABLED=false
# Additional Redis-backed daily safeguard (1..100) for Google API lookups.
# Hard Google Cloud quota/billing controls are still required.
GTH_GOOGLE_PLACES_DAILY_BUDGET=25

# Optional approved HTTPS lender/DSA referral destination. Calculator works without it.
# Public destination URL only; never put a secret or API credential here.
NEXT_PUBLIC_HOME_LOAN_AFFILIATE_URL=
