# GTH PRO environment template
# Copy to .env.local for local development.
# Never commit real secret values.

# =========================
# PUBLIC / CLIENT-SAFE
# =========================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional public contact address (defaults to this official Zoho mailbox).
# Only verified custom-domain values are accepted; never personal Gmail accounts.
NEXT_PUBLIC_SUPPORT_EMAIL=official@gthproglobal.com

# =========================
# SERVER-ONLY / REQUIRED BY FEATURES
# =========================
OPENAI_API_KEY=
GEMINI_API_KEY=
TRAVELPAYOUTS_TOKEN=
# Existing deployment alias; either name is supported.
TRAVELPAYOUTS_API_TOKEN=
AVIASALES_API_TOKEN=
PEXELS_API_KEY=

# Shared request protection. Keep URL/token server-only.
# No in-memory fallback: protected calls return 503 until configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GTH_RATE_LIMIT_NAMESPACE=gth-pro

# =========================
# SERVER-ONLY / OFFLINE INGESTION
# =========================
# Keep disabled in web deployments. Enable only for an intentional admin/import run.
GTH_INGESTION_ENABLED=false
SUPABASE_INGESTION_KEY=

# Reserved for future internal authenticated services.
GTH_INTERNAL_KEY=

# =========================
# PUBLIC SEARCH LAUNCH (SERVER-ONLY CONFIG)
# =========================
# Set true ONLY for the Vercel production environment when the custom domain
# and SEO metadata are ready. Preview builds remain noindex.
GTH_PUBLIC_LAUNCH_ENABLED=false

# =========================
# OPTIONAL GOOGLE MAPS PLACE PHOTOS (SERVER-ONLY, BILLABLE)
# =========================
# OFF by default. Never bulk-import Google Maps/Places content into Supabase.
# Requires Google Cloud Places API (New), a restricted server-only key, billing,
# a Google Maps Platform-compliant privacy policy, and a Google Cloud API quota.
# The hotel visitor explicitly clicks to fetch one live photo, credited to Google Maps.
GOOGLE_PLACES_API_KEY=
GTH_GOOGLE_PLACES_ON_DEMAND_ENABLED=false
# Additional Redis-backed daily safeguard (1..100) for Google API lookups.
# Hard Google Cloud quota/billing controls are still required.
GTH_GOOGLE_PLACES_DAILY_BUDGET=25

# Optional approved HTTPS lender/DSA referral destination. Calculator works without it.
# Public destination URL only; never put a secret or API credential here.
NEXT_PUBLIC_HOME_LOAN_AFFILIATE_URL=

# Optional public business WhatsApp destination, stored server-side.
# Country code + digits only (no plus sign). Empty = private form and official email follow-up.
GTH_BUSINESS_WHATSAPP_NUMBER=
# =========================
# UNIFIED CITY-SPINE ROUTER — STEP 1 (DISABLED / SERVER-ONLY)
# =========================
# Step 1 registers capabilities but makes ZERO changes to existing UI routes.
# Enable only in an isolated, reviewed test environment after Step 1 QA.
# No live UI/button currently imports src/lib/router/affiliateRouter.ts.
ENABLE_UNIFIED_CITY_ROUTER=false

# Optional public affiliate landing URLs read ONLY on the server.
# They are NOT credentials, but may be visible when a user follows a referral.
# Never place API secrets or privileged tokens in NEXT_PUBLIC_* variables.
# Country eligibility is enforced by providerRegistry.ts; an affiliate landing
# does not represent a verified city search, room offer or live inventory.
# HopeGoo: CN HK MO TW JP KR SG TH MY VN. Supply the exact approved tracking
# destination from the advertiser dashboard only after advertiser verification.
# Do not infer the target provider from the CJ redirect hostname alone.
# Optional PUBLIC publisher click URL for compatibility; never credentials.
# The server-side GTH_HOPEGOO_AFFILIATE_URL takes precedence.
NEXT_PUBLIC_HOPEGOO_AFFILIATE_URL=
GTH_HOPEGOO_AFFILIATE_URL=

# Public GTH/Nuitee shared white-label homepage (Flights and Stays tabs).
# Optional override is allowlisted to https://hotel.gthproglobal.com/ only.
# This is a supplier-owned portal entry, NOT a verified city/flight deep link.
# Never place supplier API keys, passwords or private tokens in NEXT_PUBLIC_*.
NEXT_PUBLIC_NUITEE_WHITE_LABEL_URL=https://hotel.gthproglobal.com

# Optional provider link overrides, only if issued/approved by that program.
# These remain unused by live UI in Step 1; existing widgets/links stay intact.
GTH_KLOOK_AFFILIATE_URL=
GTH_GETYOURGUIDE_AFFILIATE_URL=
GTH_WEGOTRIP_AFFILIATE_URL=
GTH_KKDAY_AFFILIATE_URL=
GTH_GOCITY_AFFILIATE_URL=
GTH_WELCOME_PICKUPS_AFFILIATE_URL=
GTH_GETTRANSFER_AFFILIATE_URL=

# Existing, separately owned supplier widgets are NOT configurable via Step 1:
# Nuitee hosted SearchBar; Aviasales/Travelpayouts WL ID 23459; 12Go booking
# form; transfer and rental widgets. Keep their existing modules unchanged.
# The existing public NEXT_PUBLIC_* Supabase anon key is NOT a service-role key.
# No service-role key is required or permitted by the city-spine foundation.

# STEP 2: Edge geo preferences use only Vercel geo headers and read-only
# existing destination lookups. No paid geolocation APIs, storage or redirects.
# Keep ENABLE_UNIFIED_CITY_ROUTER=false until Step 2 passes all CI gates.

# Optional public TicketNetwork CJ click link. Uses the configured campaign URL by default.
NEXT_PUBLIC_TICKETNETWORK_AFFILIATE_URL=
