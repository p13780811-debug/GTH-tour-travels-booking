# GTH PRO environment template
# Copy to .env.local for local development.
# Never commit real secret values.

# =========================
# PUBLIC / CLIENT-SAFE
# =========================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =========================
# SERVER-ONLY / REQUIRED BY FEATURES
# =========================
OPENAI_API_KEY=
GEMINI_API_KEY=
TRAVELPAYOUTS_TOKEN=
# Existing deployment alias; either name is supported.
TRAVELPAYOUTS_API_TOKEN=
AVIASALES_API_TOKEN=
PEXELS_API_KEY=

# Reserved for future internal authenticated services.
GTH_INTERNAL_KEY=

# Shared request protection. Keep URL/token server-only.
# No in-memory fallback: protected calls return 503 until configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GTH_RATE_LIMIT_NAMESPACE=gth-pro
