# Copy to .env; never commit the actual environment file.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GTH_INGESTION_ENABLED=false
RERA_USER_AGENT=GTH-PRO-Registry-Ingest/1.0 (+https://gthproglobal.com)

# Optional: choose an Overpass instance whose operator permits your workload.
# Leave blank to run without OSM. No Nominatim public API is used.
OVERPASS_URL=

# Optional, comma-separated public image CDN hostnames. No wildcard hosts.
RERA_MEDIA_HOSTS=
