{
  "name": "@gth-pro/native-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "theme:check": "node scripts/sync-theme.mjs --check",
    "theme:sync": "node scripts/sync-theme.mjs --write",
    "export": "expo export --platform android --output-dir dist",
    "export:web": "expo export --platform web --output-dir web-dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.31",
    "lucide-react-native": "^0.577.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.9.0"
  }
}
